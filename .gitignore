# =============================================
# BLOOM'S TAXONOMY LEARNING SYSTEM - .gitignore
# =============================================

# ---- Python / Backend ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.pyo
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
wheels/
.eggs/
lib/
lib64/
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
.Python
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.log
.pytest_cache/
htmlcov/

# SQLite local database (do NOT commit dev DB)
backend/learning_bloom.db
backend/*.db

# Local uploads (don't commit binary files)
backend/uploads/*
!backend/uploads/.gitkeep

# Flask instance folder
instance/

# ---- Node.js / Frontend ----
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
.yarn-integrity

# Frontend build output (Render builds this itself)
frontend/dist/

# Vite cache
frontend/.vite/

# ---- Environment Variables ----
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env
frontend/.env.local

# ---- IDE / OS ----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V5
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---- Windows ----
*.lnk

# ---- Misc ----
*.bak
*.tmp
.gemini/
