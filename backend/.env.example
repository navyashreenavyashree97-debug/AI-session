# Bloom's Taxonomy backend environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Flask Core
SECRET_KEY=change-me-to-a-random-64-char-secret
FLASK_ENV=development
FLASK_DEBUG=1

# JWT
JWT_SECRET_KEY=change-me-to-another-random-64-char-secret

# Database (leave blank to use local SQLite)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Gemini AI (get a free key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
