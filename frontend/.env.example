# Frontend environment variables
# Copy this to .env.local for local dev.
# NEVER commit .env.local to version control.

# When running Vite dev server, the proxy handles /api -> Flask automatically.
# In production, Flask itself serves the built React files, so no VITE_API_URL needed.
# Only set this if you are deploying frontend & backend as separate services.
# VITE_API_BASE_URL=https://your-render-service.onrender.com
